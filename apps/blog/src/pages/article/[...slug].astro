---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ArticleMeta from '../../components/ArticleMeta.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { SITE } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleUrl, getPublicArticles, publishedAt, updatedAt } from '../../lib/content';

export const getStaticPaths = (async () => {
  const articles = await getPublicArticles();
  return articles.map((article) => ({ params: { slug: article.data.legacySlug }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { Content, headings } = await render(article);
const publicationDate = publishedAt(article);
const modificationDate = updatedAt(article);
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: article.data.description || SITE.description,
  datePublished: new Date(`${publicationDate.replace(' ', 'T')}+08:00`).toISOString(),
  dateModified: new Date(`${modificationDate.replace(' ', 'T')}+08:00`).toISOString(),
  mainEntityOfPage: new URL(articleUrl(article), SITE.url).toString(),
  author: { '@type': 'Person', name: article.data.author },
  publisher: { '@type': 'Person', name: SITE.author },
  keywords: article.data.tags.join(', '),
};
---

<BaseLayout title={article.data.title} description={article.data.description} openGraphType="article" jsonLd={articleJsonLd}>
  <article class="article-page" data-pagefind-body data-pagefind-meta={`title:${article.data.title}`}>
    <div class="article-shell">
      <div>
        <header class="article-header">
          <p class="article-kicker">{article.data.type === 'log' ? '记录' : '文章'}</p>
          <h1>{article.data.title}</h1>
          {article.data.description && <p class="article-summary">{article.data.description}</p>}
          <ArticleMeta article={article} />
        </header>
        {headings.length > 0 && (
          <div class="mobile-toc-wrap">
            <details>
              <summary>文章目录</summary>
              <TableOfContents headings={headings} mobile />
            </details>
          </div>
        )}
        <div class="article-content"><Content /></div>
      </div>
      <aside class="desktop-toc"><TableOfContents headings={headings} /></aside>
    </div>
  </article>
</BaseLayout>
