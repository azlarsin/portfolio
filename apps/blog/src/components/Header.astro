---
import { SITE } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const { currentPath = '/' } = Astro.props;
const navigation = [
  { href: '/', label: '首页' },
  { href: '/archives/', label: '归档' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];

function active(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label={`${SITE.name} 首页`}>
      <span>{SITE.shortName}</span>
      <span class="wordmark-dot" aria-hidden="true">.</span>
      <span class="wordmark-notes">notes</span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="search-link" href="/search/" aria-label="搜索文章">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="6.5" />
          <path d="m16 16 4.25 4.25" />
        </svg>
        <span>搜索</span>
      </a>
      <ThemeToggle />
    </nav>

    <div class="mobile-actions">
      <ThemeToggle />
      <details class="mobile-menu">
        <summary aria-label="打开导航菜单">
          <span></span><span></span><span></span>
        </summary>
        <nav aria-label="移动端主导航">
          {navigation.map((item) => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
          <a href="/search/">搜索</a>
        </nav>
      </details>
    </div>
  </div>
</header>
