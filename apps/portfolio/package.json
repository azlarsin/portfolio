{
  "name": "@portfolio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .seo-ssr && node scripts/generate-seo-pages.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:built": "node --test tests/seo-build-contract.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "^1.41.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
