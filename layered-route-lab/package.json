{
  "name": "layered-route-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:agent": "node scripts/generate-agent-manifest.mjs",
    "predev": "pnpm run generate:agent",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "pnpm run generate:agent",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:static": "pnpm run generate:agent && VITE_STATIC_DEMO=1 vite build --config vite.static.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "ALLOW_LOCAL_DEMO_URL=1 NEXT_PUBLIC_SITE_URL=http://localhost:3000 pnpm run build && pnpm run test:built",
    "test:built": "ALLOW_LOCAL_DEMO_URL=1 NEXT_PUBLIC_SITE_URL=http://localhost:3000 node --test tests/*.test.mjs",
    "check": "pnpm run lint",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-static --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
