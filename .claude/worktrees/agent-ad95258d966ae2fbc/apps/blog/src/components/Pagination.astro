---
import { paginatedUrl } from '../lib/content';

interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { currentPage, totalPages, basePath = '/' } = Astro.props;

function pageNumbers() {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);

  const nearby = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);
  return [...nearby]
    .filter((page) => page >= 1 && page <= totalPages)
    .sort((left, right) => left - right);
}

const pages = pageNumbers();
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="文章分页">
    {currentPage > 1 && <a class="pagination-direction" href={paginatedUrl(basePath, currentPage - 1)} rel="prev">← 上一页</a>}
    {pages.map((page, index) => (
      <>
        {index > 0 && page - pages[index - 1] > 1 && <span class="pagination-ellipsis" aria-hidden="true">…</span>}
        {page === currentPage
          ? <span aria-current="page" aria-label={`第 ${page} 页，当前页`}>{page}</span>
          : <a href={paginatedUrl(basePath, page)} aria-label={`第 ${page} 页`}>{page}</a>}
      </>
    ))}
    {currentPage < totalPages && <a class="pagination-direction" href={paginatedUrl(basePath, currentPage + 1)} rel="next">下一页 →</a>}
  </nav>
)}
