{
  "name": "azlar-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream --if-present run dev",
    "dev:portfolio": "pnpm --filter @portfolio/web dev",
    "dev:layered-route-lab": "pnpm --filter layered-route-lab dev",
    "build": "pnpm --recursive --if-present run build",
    "build:local": "ALLOW_LOCAL_DEMO_URL=1 NEXT_PUBLIC_SITE_URL=http://localhost:3000 VITE_LAYERED_ROUTE_LAB_URL=http://localhost:3000 pnpm build",
    "check": "pnpm --recursive --if-present run check",
    "test": "pnpm --filter layered-route-lab test",
    "verify:local": "pnpm check && pnpm build:local && pnpm --filter layered-route-lab test:built",
    "start": "pnpm --recursive --parallel --stream --if-present run start",
    "start:local": "ALLOW_LOCAL_DEMO_URL=1 NEXT_PUBLIC_SITE_URL=http://localhost:3000 pnpm start",
    "start:portfolio": "pnpm --filter @portfolio/web start",
    "start:demo": "pnpm --filter layered-route-lab start"
  }
}
